# Supabase - Get these from your Supabase project dashboard
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for scheduled writes. Missing/incorrect secrets fail closed.
CRON_SECRET=
# Comma-separated verified auth user UUIDs permitted to use private MCP tools
# and independently resolve other agents' predictions. No users allowed by default.
OPERATOR_USER_IDS=
# Production always uses the database-backed atomic limiter (migration 013).
# Opt in locally to exercise the same path; otherwise development uses memory.
RATE_LIMIT_BACKEND=supabase

# Resend - Get from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Web Push VAPID Keys - Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fonts: Jost + Space Mono are self-hosted by next/font/google.
# Build-time access to Google Fonts is required; no runtime API key is needed.

# ElevenLabs: optional, only for scripts/generate-audio.mjs, not runtime playback.
# Generate static MP3s in public/audio/ before enabling lesson/writing audio.
# ELEVENLABS_API_KEY=

# Merchant map: optional raster provider override (public browser URL).
# Default: standard OpenStreetMap tiles, no API key required. Follow its usage policy:
# https://operations.osmfoundation.org/policies/tiles/
# For higher traffic, use a dedicated provider and its required attribution.
# NEXT_PUBLIC_MAP_TILE_URL=https://your-provider/{z}/{x}/{y}.png?key=your-public-key
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; Your provider &copy; OpenStreetMap contributors

# CryptoPanic - Get from https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your-cryptopanic-api-key

# ── Sovereign Bitcoin node (Umbrel self-hosted mempool.space) ──
# Base URL of the tunneled self-hosted mempool API (no trailing path).
# Leave unset to use the public mempool.space fallback.
NODE_MEMPOOL_URL=https://mempool.contrabxnd.io
# Set false to prohibit public fallback for server-side node lookups.
NODE_PUBLIC_FALLBACK=true
# WebSocket URL for the live block/tx feed (browser-direct). NEXT_PUBLIC_ so it
# reaches the client. Falls back to wss://mempool.space/api/v1/ws if unset.
NEXT_PUBLIC_NODE_MEMPOOL_WS_URL=wss://mempool.contrabxnd.io/api/v1/ws
# Cloudflare Access service token (optional) — protects the tunnel hostname so
# only Contrabxnd can query the node. Create under Zero Trust > Access > Service Auth.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ── Lightning (LND REST over a 2nd Cloudflare Tunnel hostname) ──
# Base URL of the tunneled LND REST API (no trailing path).
LND_REST_URL=https://lnd.cbx-node.com
# Hex-encoded READ + INVOICE macaroon (NOT admin — must not be able to spend).
# Bake with: lncli bakemacaroon info:read offchain:read onchain:read \
#   invoices:read invoices:write --save_to cbx.macaroon
# then: xxd -ps -c 1000 cbx.macaroon
LND_MACAROON_HEX=

# L402 paywall — server secret for signing micropayment tokens (HMAC).
# Generate: openssl rand -hex 32
L402_SECRET=
